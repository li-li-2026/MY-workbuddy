<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 512 512%27%3E%3Crect width=%27512%27 height=%27512%27 rx=%27100%27 fill=%27%234c6e4b%27/%3E%3Ctext x=%27256%27 y=%27256%27 font-family=%27Helvetica,Arial,sans-serif%27 font-size=%27280%27 font-weight=%27bold%27 fill=%27%23ffffff%27 text-anchor=%27middle%27 dominant-baseline=%27central%27%3E文%3C/text%3E%3C/svg%3E">
<title>李李工作台</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{--bg:#ededed;--card:#fff;--text:#1a1a1a;--muted:#888;--primary:#07c160;--primary-light:#e8f8ef;--primary-dark:#06ad56;--accent:#5e7ce0;--warn:#ff9c19;--danger:#fa5151;--border:#e6e6e6;--radius:12px;--safe-top:env(safe-area-inset-top,0px);--safe-bottom:env(safe-area-inset-bottom,0px)}
html,body{height:100%;overflow:hidden}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);-webkit-user-select:none;user-select:none}
.app{max-width:520px;margin:0 auto;height:100vh;display:flex;flex-direction:column;position:relative}
.topbar{background:var(--card);padding:calc(12px + var(--safe-top)) 16px 12px;border-bottom:1px solid var(--border);position:relative;z-index:5;flex-shrink:0}
.topbar h1{font-size:19px;font-weight:800}
.topbar p{font-size:12px;color:var(--muted);margin-top:2px}
.content{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:12px 0 80px}
.menu-group{background:var(--card);border-radius:var(--radius);overflow:hidden;margin:0 12px 8px}
.menu-item{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;border-bottom:1px solid var(--border);position:relative;transition:background .1s}
.menu-item:last-child{border-bottom:none}
.menu-item:active{background:#f5f5f5}
.menu-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.menu-info{flex:1;min-width:0}
.menu-info .name{font-size:15px;font-weight:600}
.menu-info .desc{font-size:12px;color:var(--muted);margin-top:1px}
.menu-arrow{color:#c8c8c8;font-size:16px}
.menu-badge{background:var(--danger);color:#fff;font-size:10px;padding:1px 6px;border-radius:999px;font-weight:700}
.section-title{font-size:13px;font-weight:700;color:var(--muted);margin:12px 16px 8px}
.detail{display:none;position:absolute;inset:0;z-index:20;background:var(--bg);flex-direction:column}
.detail.active{display:flex}
.detail-header{background:var(--card);padding:calc(10px + var(--safe-top)) 12px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;flex-shrink:0}
.back{background:none;border:none;font-size:16px;color:var(--primary);cursor:pointer;font-weight:600;display:flex;align-items:center;gap:2px}
.detail-header h2{font-size:17px;font-weight:800}
.detail-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:12px 16px calc(20px + var(--safe-bottom))}
.card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:10px}
.card h3{font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.btn{border:none;border-radius:10px;padding:9px 14px;font-size:14px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:active{background:var(--primary-dark)}
.btn-soft{background:var(--primary-light);color:var(--primary-dark)}
.btn-gray{background:#f0f0f0;color:var(--text)}
.btn-danger{background:#ffeded;color:var(--danger)}
.toolbar{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
input,textarea,select{border:1px solid var(--border);border-radius:10px;padding:9px 11px;font-size:14px;outline:none;font-family:inherit;width:100%}
input:focus,textarea:focus{border-color:var(--primary)}
.form-row{display:flex;gap:8px;margin-bottom:8px}
.form-row input,.form-row select{flex:1}
.list{list-style:none}
.list li{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.list li:last-child{border-bottom:none}
.list li input[type=checkbox]{width:20px;height:20px;accent-color:var(--primary);flex-shrink:0}
.list li .text{flex:1;font-size:14px;line-height:1.4}
.list li .text.done{text-decoration:line-through;color:var(--muted)}
.badge{display:inline-block;padding:2px 7px;border-radius:999px;font-size:11px;font-weight:700}
.b-green{background:#d1fae5;color:#065f46}.b-blue{background:#dbeafe;color:#1e40af}
.b-amber{background:#fef3c7;color:#92400e}.b-red{background:#fee2e2;color:#991b1b}
.idea{background:#f9fafb;border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:8px}
.idea .t{font-weight:600;margin-bottom:4px;font-size:14px;line-height:1.4}
.idea .m{font-size:12px;color:var(--muted)}
.idea .actions{margin-top:8px;display:flex;gap:6px}
.progress{background:#e5e7eb;border-radius:999px;height:7px;overflow:hidden;margin-top:8px}
.progress-bar{background:var(--primary);height:100%;transition:width .3s}
.loading{text-align:center;color:var(--muted);padding:16px;font-size:14px}
.hot-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.hot-item:last-child{border-bottom:none}
.hot-rank{width:22px;text-align:center;font-weight:800;font-size:15px;color:var(--muted)}
.hot-rank.top{color:var(--danger)}
.hot-title{flex:1;font-size:14px;line-height:1.4}
.hot-hot{font-size:11px;color:var(--warn);white-space:nowrap}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--border)}
th{color:var(--muted);font-size:12px}
.empty{text-align:center;color:var(--muted);padding:20px;font-size:13px}
footer{text-align:center;color:var(--muted);font-size:11px;padding:16px}
.tabbar{display:flex;background:var(--card);border-top:1px solid var(--border);padding:4px 0 calc(4px + var(--safe-bottom));flex-shrink:0}
.tabbar .tab{flex:1;text-align:center;font-size:11px;color:var(--muted);cursor:pointer;padding:4px}
.tab.active{color:var(--primary);font-weight:700}
.tab .icon{font-size:20px;display:block;margin-bottom:2px}
.fade-in{animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="app">
<div class="topbar"><h1>创作工作台</h1><p>完成一项打勾，进度一目了然</p></div>
<div class="content" id="home-content">
<div class="section-title">📌 今日任务</div>
<div class="menu-group" id="today-group"></div>
<div class="section-title">📚 学习成长</div>
<div class="menu-group" id="learn-group"></div>
<div class="section-title">💡 内容创作</div>
<div class="menu-group" id="create-group"></div>
<div class="section-title">🧘 生活记录</div>
<div class="menu-group" id="life-group"></div>
<footer>WorkBuddy · 数据保存在本机</footer>
</div>
<div class="tabbar">
<div class="tab active" onclick="goHome()"><span class="icon">🏠</span>工作台</div>
<div class="tab" onclick="goStats()"><span class="icon">📊</span>统计</div>
<div class="tab" onclick="goSettings()"><span class="icon">⚙️</span>设置</div>
</div>
<div class="detail" id="detail-view">
<div class="detail-header"><button class="back" onclick="closeDetail()">‹ 返回</button><h2 id="detail-title">详情</h2></div>
<div class="detail-body" id="detail-body"></div>
</div>
</div>
<script>
const $=s=>document.querySelector(s);
const $$=s=>[...document.querySelectorAll(s)];
const LS=localStorage;
const today=()=>new Date().toLocaleDateString('zh-CN');
function save(k,v){LS.setItem('wb_'+k,JSON.stringify(v))}
function load(k,d){try{return JSON.parse(LS.getItem('wb_'+k))??d}catch{return d}}
let habits=load('habits',[{id:1,name:'舞蹈练习 30 分钟',done:false,cat:'hiphop'},{id:2,name:'吉他爬格子 20 分钟',done:false,cat:'guitar'},{id:3,name:'体态矫正训练',done:false,cat:'posture'},{id:4,name:'阅读/学习 30 分钟',done:false,cat:'learn'}]);
let topics=load('topics',[]);
let reviews=load('reviews',[]);
let danceNotes=load('danceNotes',[]);
let songs=load('songs',[]);
let gears=load('gears',[]);
let postureLogs=load('postureLogs',[]);
let moods=load('moods',[]);
let avoids=load('avoids',[]);
let products=load('products',[]);
const menuItems=[
{id:'checkin',name:'每日打卡计划',desc:'舞蹈·吉他·体态·学习',icon:'✅',color:'#07c160',group:'today',badge:0},
{id:'video',name:'短视频选题灵感',desc:'自动抓取热点 · 文案复盘',icon:'🎬',color:'#5e7ce0',group:'create',badge:1},
{id:'hiphop',name:'Hiphop 舞蹈自学',desc:'周训练计划 · 纠错笔记',icon:'🕺',color:'#fa5151',group:'learn',badge:0},
{id:'guitar',name:'电吉他自学进度',desc:'入门知识 · 乐谱 · 配件',icon:'🎸',color:'#ff9c19',group:'learn',badge:0},
{id:'posture',name:'体态矫正记录',desc:'高低肩·腰酸矫正打卡',icon:'🧘',color:'#07c160',group:'life',badge:0},
{id:'mood',name:'每日金融小知识',desc:'每天一个股票/金融知识·配视频',icon:'💰',color:'#5e7ce0',group:'life',badge:0},
{id:'fitness',name:'健身训练',desc:'选部位生成动作·配套视频',icon:'💪',color:'#fa5151',group:'today',badge:0},
{id:'posturefix',name:'体态矫正专区',desc:'大小脸·脊柱侧弯·O型腿·足弓',icon:'🦴',color:'#5e7ce0',group:'today',badge:0},
{id:'english',name:'英语口语练习',desc:'三个月开口说·跟读+对话',icon:'🗣️',color:'#5e7ce0',group:'learn',badge:0},
{id:'operate',name:'运营学习',desc:'0基础入门·新媒体运营实战',icon:'📈',color:'#ff9c19',group:'learn',badge:0}
];
function renderMenu(){
const todayHtml=menuItems.filter(m=>m.group==='today').map(renderMenuItem).join('');
const learnHtml=menuItems.filter(m=>m.group==='learn').map(renderMenuItem).join('');
const createHtml=menuItems.filter(m=>m.group==='create').map(renderMenuItem).join('');
const lifeHtml=menuItems.filter(m=>m.group==='life').map(renderMenuItem).join('');
$('#today-group').innerHTML=todayHtml;
$('#learn-group').innerHTML=learnHtml;
$('#create-group').innerHTML=createHtml;
$('#life-group').innerHTML=lifeHtml;
}
function renderMenuItem(m){
let badge='';
if(m.id==='checkin'){const c=habits.filter(h=>!h.done).length;if(c)badge=`<span class="menu-badge">${c}</span>`}
return `<div class="menu-item" onclick="openDetail('${m.id}')"><div class="menu-icon" style="background:${m.color}22">${m.icon}</div><div class="menu-info"><div class="name">${m.name}</div><div class="desc">${m.desc}</div></div>${badge}<span class="menu-arrow">›</span></div>`;
}
function openDetail(id){
const m=menuItems.find(x=>x.id===id);
$('#detail-title').textContent=m.name;
$('#detail-body').innerHTML=detailRenderers[id]();
$('#detail-view').classList.add('active');
$('#detail-view').classList.add('fade-in');
setTimeout(()=>$('#detail-view').classList.remove('fade-in'),250);
if(detailInits[id])detailInits[id]();
}
function closeDetail(){$('#detail-view').classList.remove('active')}
const detailRenderers={
checkin:()=>`<div class="card"><h3>📋 每日打卡</h3><div class="form-row"><input type="text" id="new-habit" placeholder="添加打卡项，如：练吉他 20 分钟"><button class="btn btn-primary" onclick="addHabit()">添加</button></div><ul class="list" id="habit-list"></ul><div class="progress"><div class="progress-bar" id="habit-progress" style="width:0%"></div></div></div><button class="btn btn-gray" style="width:100%" onclick="resetDaily()">🔄 重置今日打卡</button>`,
video:()=>`<div class="card"><h3>🔥 实时热搜抓取</h3><div class="toolbar"><button class="btn btn-primary" onclick="fetchHot('douyin')">抓取抖音热点</button><button class="btn btn-soft" onclick="fetchHot('bilihot')">抓取B站热点</button></div><div id="hot-list"><div class="empty">点击上方按钮抓取最新热点</div></div></div><div class="card"><h3>💡 我的选题灵感</h3><div class="form-row"><input type="text" id="v-idea" placeholder="输入选题想法"><button class="btn btn-primary" onclick="addTopic()">收藏</button></div><div id="topic-list"></div></div><div class="card"><h3>📝 文案复盘</h3><div class="form-row"><input type="text" id="v-title" placeholder="视频标题"><select id="v-type"><option>干货教程</option><option>生活vlog</option><option>挑战/变装</option><option>情绪共鸣</option></select><button class="btn btn-primary" onclick="addReview()">保存</button></div><textarea id="v-notes" rows="2" placeholder="数据表现、可复用点、下次改进..."></textarea><ul class="list" id="review-list" style="margin-top:8px"></ul></div>`,
hiphop:()=>`<div class="card"><h3>📅 本周训练计划</h3><div class="toolbar"><button class="btn btn-primary" onclick="genDancePlan()">生成训练计划</button></div><div id="dance-plan"></div></div><div class="card"><h3>🩺 动作纠错笔记</h3><div class="form-row"><input type="text" id="dance-note-input" placeholder="如：做 Wave 时肩膀太紧"><button class="btn btn-primary" onclick="addDanceNote()">添加</button></div><ul class="list" id="dance-notes"></ul></div>`,
guitar:()=>`<div class="card"><h3>📚 入门知识点</h3><div class="toolbar"><button class="btn btn-primary" onclick="showGuitarBasics()">整理入门知识</button></div><div id="guitar-basics"></div></div><div class="card"><h3>🎼 乐谱 & 练习记录</h3><div class="form-row"><input type="text" id="g-song" placeholder="曲目名"><select id="g-status"><option>学习中</option><option>已会</option><option>复习</option></select><button class="btn btn-primary" onclick="addSong()">添加</button></div><ul class="list" id="guitar-songs"></ul></div><div class="card"><h3>🔌 配件功课</h3><div class="form-row"><input type="text" id="g-gear" placeholder="效果器/音箱/线材"><button class="btn btn-soft" onclick="addGear()">添加</button></div><ul class="list" id="gear-notes"></ul></div>`,
posture:()=>`<div class="card"><h3>🧘 矫正动作清单</h3><div class="toolbar"><button class="btn btn-primary" onclick="genPosturePlan()">生成矫正清单</button><button class="btn btn-soft" onclick="addPostureLog()">完成打卡</button></div><div id="posture-plan"></div></div><div class="card"><h3>📊 打卡记录</h3><ul class="list" id="posture-logs"></ul></div>`,
mood:()=>`<div class="card"><h3>💰 今日金融小知识</h3><div style="font-size:13px;color:#888;margin-bottom:10px;line-height:1.5">每天学一个股票/金融知识，点击主题查看<strong style="color:#5e7ce0">B站/抖音教学视频</strong>。</div><div class="toolbar"><button class="btn btn-primary" onclick="genFinPlan('stock')">股票基础</button><button class="btn btn-soft" onclick="genFinPlan('fund')">基金理财</button><button class="btn btn-soft" onclick="genFinPlan('economy')">宏观经济</button><button class="btn btn-soft" onclick="genFinPlan('skill')">实战技巧</button></div><div id="fin-plan"><div class="empty">点上方按钮，生成今日知识点 + 视频</div></div></div><div class="card"><h3>📚 快捷视频入口</h3><div id="fin-videos"></div></div><div class="card"><h3>✏️ 学习打卡</h3><div class="form-row"><input type="text" id="fin-log-input" placeholder="如：学了K线图基础+笔记"><button class="btn btn-primary" onclick="addFinLog()">记录</button></div><ul class="list" id="fin-logs"></ul></div>`,
fitness:()=>`<div class="card"><h3>💪 选择训练部位</h3><div class="toolbar" id="fit-parts"><button class="btn btn-primary" onclick="genFitPlan('胸')">胸肌</button><button class="btn btn-soft" onclick="genFitPlan('背')">背部</button><button class="btn btn-soft" onclick="genFitPlan('腿')">腿部</button><button class="btn btn-soft" onclick="genFitPlan('肩')">肩部</button><button class="btn btn-soft" onclick="genFitPlan('核心')">核心</button><button class="btn btn-soft" onclick="genFitPlan('全身燃脂')">全身燃脂</button></div><div id="fit-plan"><div class="empty">点上方按钮，自动生成动作 + 教学视频</div></div></div><div class="card"><h3>🎯 我的训练记录</h3><div class="form-row"><input type="text" id="fit-log-input" placeholder="如：卧推 40kg×10×3组"><button class="btn btn-primary" onclick="addFitLog()">记录</button></div><ul class="list" id="fit-logs"></ul></div>`,
english:()=>`<div class="card"><h3>🗣️ 三个月口语突破计划</h3><div style="font-size:13px;color:#888;margin-bottom:10px;line-height:1.5">点击月份查看每日练习任务，每个任务都配了<strong style="color:#5e7ce0">B站/抖音教学视频</strong>，跟着练就行。</div><div class="toolbar"><button class="btn btn-primary" onclick="genEngPlan(1)">第1月·打基础</button><button class="btn btn-soft" onclick="genEngPlan(2)">第2月·练表达</button><button class="btn btn-soft" onclick="genEngPlan(3)">第3月·实战</button></div><div id="eng-plan"><div class="empty">点上方按钮，生成当月练习计划 + 视频</div></div></div><div class="card"><h3>📚 快捷视频入口</h3><div id="eng-videos"></div></div><div class="card"><h3>✏️ 口语练习打卡</h3><div class="form-row"><input type="text" id="eng-log-input" placeholder="如：跟读VOA 15分钟 + 录音对比"><button class="btn btn-primary" onclick="addEngLog()">记录</button></div><ul class="list" id="eng-logs"></ul></div>`,
operate:()=>`<div class="card"><h3>📈 0基础运营入门路线</h3><div style="font-size:13px;color:#888;margin-bottom:10px;line-height:1.5">从0开始学运营，按阶段点击查看学习任务，每个任务都配了<strong style="color:#ff9c19">B站/抖音教学视频</strong>。</div><div class="toolbar"><button class="btn btn-primary" onclick="genOpPlan(1)">阶段1·认知</button><button class="btn btn-soft" onclick="genOpPlan(2)">阶段2·实操</button><button class="btn btn-soft" onclick="genOpPlan(3)">阶段3·进阶</button></div><div id="op-plan"><div class="empty">点上方按钮，生成学习任务 + 视频</div></div></div><div class="card"><h3>📚 运营快捷视频</h3><div id="op-videos"></div></div><div class="card"><h3>✏️ 学习打卡</h3><div class="form-row"><input type="text" id="op-log-input" placeholder="如：学了小红书选题技巧 + 笔记"><button class="btn btn-primary" onclick="addOpLog()">记录</button></div><ul class="list" id="op-logs"></ul></div>`,
posturefix:()=>`<div class="card"><h3>🦴 体态矫正专区</h3><div style="font-size:13px;color:#888;margin-bottom:10px;line-height:1.5">选择你的体态问题，生成矫正动作 + <strong style="color:#5e7ce0">B站/抖音教学视频</strong>。</div><div class="toolbar"><button class="btn btn-primary" onclick="genPfPlan('face')">大小脸/脸型</button><button class="btn btn-soft" onclick="genPfPlan('spine')">脊柱侧弯</button><button class="btn btn-soft" onclick="genPfPlan('leg')">O型腿</button><button class="btn btn-soft" onclick="genPfPlan('foot')">足弓塌陷</button><button class="btn btn-soft" onclick="genPfPlan('calf')">小腿外翻</button><button class="btn btn-soft" onclick="genPfPlan('chin')">下巴后缩</button></div><div id="pf-plan"><div class="empty">点上方按钮，生成矫正动作 + 视频</div></div></div><div class="card"><h3>⚠️ 重要提醒</h3><div style="font-size:13px;color:#888;line-height:1.6"><p>• <b>大小脸/大小眼/颧骨突出/脸型不流畅</b>：多为骨骼结构问题，训练改善有限，严重建议咨询正颌或正畸医生</p><p>• <b>脊柱侧弯</b>：Cobb角＞40度建议就医，轻度可通过施罗特体操改善</p><p>• <b>下巴后缩</b>：可能是牙齿咬合问题，建议看正畸科</p><p>• 矫正训练需<b>每天坚持</b>，至少3个月才有效果</p></div></div><div class="card"><h3>✏️ 矫正打卡</h3><div class="form-row"><input type="text" id="pf-log-input" placeholder="如：施罗特体操20分钟+足弓训练"><button class="btn btn-primary" onclick="addPfLog()">记录</button></div><ul class="list" id="pf-logs"></ul></div>`
};
